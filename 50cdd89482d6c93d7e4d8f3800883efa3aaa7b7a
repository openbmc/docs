      "writtenOn": "2026-11-16T03:57:30Z",
      "side": 1,
      "message": "Im looking at both, a sysfs traversal (excluding USB as MCTPUSBTarget covers this) and an example EM configs.",
      "parentUuid": "3e1ef747_be88885f",
      "revId": "50cdd89482d6c93d7e4d8f3800883efa3aaa7b7a",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
