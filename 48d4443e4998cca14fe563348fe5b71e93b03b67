      "lineNbr": 288,
      "author": {
        "id": 1000086
      },
      "writtenOn": "2026-08-11T02:19:57Z",
      "side": 1,
      "message": "My expectation is that CPER diagnostic interfaces would be naturally bounded by the phosphor-logging entry limit because the CPER interface is attached to an individual log entry rather than existing as an independent object.\n\nThat said, platform-specific CPER retention requirements would need to remain aligned with the configured log retention limits.\n@Matt @Patrick any Thought on this ?",
      "parentUuid": "7bc03364_38647bb1",
      "revId": "48d4443e4998cca14fe563348fe5b71e93b03b67",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
