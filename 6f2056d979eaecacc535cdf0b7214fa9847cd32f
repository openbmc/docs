      },
      "writtenOn": "2026-11-03T09:36:51Z",
      "side": 1,
      "message": "How does association works when AST2600 config define more than one USB Port `Contacts`? Is value of properties within the `Contacts` config used to establish association?",
      "range": {
        "startLine": 443,
        "startChar": 33,
        "endLine": 445,
        "endChar": 44
      },
      "revId": "6f2056d979eaecacc535cdf0b7214fa9847cd32f",
