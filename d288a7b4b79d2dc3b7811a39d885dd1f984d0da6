        "id": 1001762
      },
      "writtenOn": "2026-10-05T05:51:27Z",
      "side": 1,
      "message": "I wasn\u0027t aware that maintainership could be organized on a per-folder basis within a repository. My initial concern about the review burden was based on the assumption that the repository maintainers are responsible for all code within the repo.",
      "parentUuid": "886fd38d_b1f4fd79",
      "range": {
        "startLine": 291,
        "startChar": 77,
        "endLine": 294,
        "endChar": 50
      },
      "revId": "d288a7b4b79d2dc3b7811a39d885dd1f984d0da6",
